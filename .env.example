# Variables de entorno que usan los workflows de n8n (se leen con $env.NOMBRE).
# Copia este fichero a .env y rellénalo. Nunca subas el .env.

# Fuentes de ofertas
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
APIFY_API_TOKEN=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Healthchecks.io: un ping por workflow para saber si dejó de ejecutarse
HEALTHCHECKS_PING_URL=
HEALTHCHECKS_PING_URL_GENERACION_CV=
HEALTHCHECKS_PING_URL_SEGUIMIENTO=
HEALTHCHECKS_PING_URL_ARCHIVADO=

    {
      "id": "dae8cdeb-283d-4f1d-be33-30efb80dfdc0",
      "name": "Decisión archivar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const filas = $('Analizar archivar').all();\nconst hoy = new Date();\nconst DIAS_LIMITE = 7;\nconst DIAS_SIN_RESPUESTA = 30;\n\nconst paraArchivar = [];\n\nfor (const fila of filas) {\n  const oferta = fila.json;\n  const estado = oferta.estado;\n\n  // Regla 1: descartadas y rechazadas, siempre\n  if (estado === 'descartada' || estado === 'rechazada') {\n    paraArchivar.push(oferta);\n    continue;\n  }\n\n  // Regla 2: pendientes con más de 7 días\n  if (estado === 'pendiente') {\n    const guardado = new Date(oferta.fecha_guardado);\n    const diasPasados = (hoy - guardado) / (1000 * 60 * 60 * 24);\n    if (diasPasados > DIAS_LIMITE) {\n      paraArchivar.push(oferta);\n    }\n    continue;\n  }\n\n  // Regla 3 (tarea 12, 31 ago 2026): cv_enviado sin respuesta a los 30 días.\n  // \"Sin respuesta\" = el estado sigue en cv_enviado (Mar no lo ha avanzado a\n  // mano) y Jobs · seguimiento no ha propuesto ningún estado (estado_propuesto\n  // vacío). fecha_envio la escribe Jobs · generación CV al marcar cv_enviado;\n  // las filas antiguas sin fecha_envio se ignoran. Se archiva directa con\n  // estado: sin_respuesta (una copia, sin mutar el item original), sin pasar\n  // nunca por el desplegable de Ofertas_activas.\n  if (estado === 'cv_enviado') {\n    const propuesto = (oferta.estado_propuesto ?? '').toString().trim();\n    const envioRaw = (oferta.fecha_envio ?? '').toString().trim();\n    if (!propuesto && envioRaw) {\n      const envio = new Date(envioRaw);\n      if (!isNaN(envio.getTime())) {\n        const diasDesdeEnvio = (hoy - envio) / (1000 * 60 * 60 * 24);\n        if (diasDesdeEnvio >= DIAS_SIN_RESPUESTA) {\n          paraArchivar.push({ ...oferta, estado: 'sin_respuesta' });\n        }\n      }\n    }\n    continue;\n  }\n}\n\n// 17 ago 2026: si no hay nada que archivar, un array vacio corta la cadena\n// entera en n8n (0 items no dispara los nodos siguientes) y Ping Healthchecks\n// nunca llegaria a ejecutarse. Se emite un item centinela para que el nodo\n// If de abajo pueda mandarlo directo al ping.\nif (paraArchivar.length === 0) {\n  return [{ json: { _sinArchivar: true } }];\n}\nreturn paraArchivar.map(oferta => ({ json: oferta }));"
      }
    },
